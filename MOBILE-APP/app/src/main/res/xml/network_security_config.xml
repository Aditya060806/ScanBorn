<?xml version="1.0" encoding="utf-8"?>
<!--
  The orchestrator runs plain HTTP on the laptop, on the owner's own network
  (docs/superpowers/plans/2026-09-15-phase-5-capture.md, decision 11). Android cannot limit
  cleartext to private addresses, so it is allowed; the app's only network use is the
  orchestrator address entered in Settings.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
