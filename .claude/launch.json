{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "orchestrator",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "orchestrator.service:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "orchestrator-isolated",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/serve_isolated.py"
      ],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "dashboard",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
