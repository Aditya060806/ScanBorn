# Copy to .env and fill in. Never commit the real .env (already gitignored).
# Every variable here is optional: with an empty .env the whole pipeline runs offline.


# ---------------------------------------------------------------- planner selection
# Which backend turns natural language into a task graph, and which infers the
# environment profile from a scan.
#
#   local   on-device / in-process, no network            (default)
#   groq    Groq-hosted open-weight model                 (needs GROQ_API_KEY)
#   sarvam  Sarvam API                                    (needs SARVAM_API_KEY)
#
# IMPORTANT: setting an API key does NOT switch anything on. A provider has to be
# named here. That is deliberate — a stray key in a shell profile must never be
# enough to put a network call in the middle of an on-device demo.
SCANBORN_PLANNER=local
SCANBORN_PROFILER=local


# ------------------------------------------------------------------- model providers
# Groq serves open-weight models (Llama / Qwen / Gemma family), which is the same
# class of model the on-device llama.cpp path runs — so it works as a drop-in
# development stand-in for the phone without re-tuning prompts.
GROQ_API_KEY=
# Groq's catalogue moves; pin whichever model you actually tested against.
GROQ_MODEL=

# Sarvam Task Engine — multilingual NL -> task-graph planning.
SARVAM_API_KEY=

# Optional: Hugging Face token, if pulling gated model weights.
HF_TOKEN=


# ---------------------------------------------------------------------- edge export
# Qualcomm AI Hub — export/quantize/profile models for the Hexagon NPU.
# Requires Snapdragon hardware to be useful; there is no Exynos equivalent.
# Get a token at https://app.aihub.qualcomm.com
AI_HUB_API_TOKEN=


# --------------------------------------------------------------------------- storage
# Where the orchestrator keeps its SQLite metadata store and its scan/mesh artifacts.
# Defaults shown; both are created on first use.
SCANBORN_DB=data/scanborn.db
SCANBORN_DATA=data


# ------------------------------------------------------------------------- dashboard
# Read by dashboard/vite.config.ts to proxy API calls to the orchestrator, so the
# browser talks to one origin and the orchestrator needs no CORS configuration.
ORCHESTRATOR_URL=http://localhost:8000
