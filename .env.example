# Copy to .env and fill in. Never commit the real .env (already gitignored).
# Every variable here is optional: with an empty .env the whole pipeline runs offline.


# ---------------------------------------------------------------- planner selection
# Which backend turns natural language into a task graph (SCANBORN_PLANNER), and which
# infers the environment profile from a scan (SCANBORN_PROFILER).
#
#   local   in the orchestrator's process on this machine, no network   (default)
#   groq    Groq-hosted open-weight model, remote          (needs GROQ_API_KEY)
#   sarvam  Sarvam API, remote; planner only               (needs SARVAM_API_KEY)
#
# The phone's on-device Qwen model is a separate client feature; it is not selected here.
# IMPORTANT: setting an API key does NOT switch anything on. A provider has to be
# named here. That is deliberate — a stray key in a shell profile must never be
# enough to put a network call in the middle of a demo. A name that is not listed above
# (a typo such as "grok") is refused with HTTP 503 before the stage runs; it used to fall
# back to local silently. GET /providers shows each workload's setting and readiness.
#
# Each setting is an ordered chain: "groq,local" asks Groq first and, if it fails or
# returns something invalid, uses the local provider and records why. "groq" alone
# fails rather than guessing when Groq cannot answer. Every result is checked by the same
# contract (sarvam/task_engine/contract.py): a target not in the scan, or shared by two
# objects, is a question for the operator, never a guess. A remote planner receives the
# instruction and the scan's object labels; a remote profiler a one-line scene summary.
SCANBORN_PLANNER=local
# Explicit operator choices saved via dashboard/Android (/providers/settings) override these
# provider defaults in DATA_DIR/provider-settings.json. Keys and request limits remain server-only.
SCANBORN_PROFILER=local

# Limits on remote requests (defaults shown). Retries happen only when the request
# provably was not processed (no connection, HTTP 429 or 503); a read timeout or other 5xx
# may already have run and been billed, so it moves to the next provider instead. The
# daily ceiling counts remote requests across providers and survives a restart; cost is
# not known to ScanBorn, so requests are what it can limit.
SCANBORN_PROVIDER_DEADLINE_S=20
SCANBORN_PROVIDER_TIMEOUT_S=10
SCANBORN_PROVIDER_RETRIES=1
SCANBORN_PROVIDER_MAX_BYTES=65536
SCANBORN_PROVIDER_CONCURRENCY=2
SCANBORN_REMOTE_DAILY_LIMIT=200


# ------------------------------------------------------------------- model providers
# Groq serves open-weight models (Llama / Qwen / Gemma family), which is the same
# class of model the on-device llama.cpp path runs — so it works as a drop-in
# development stand-in for the phone without re-tuning prompts.
GROQ_API_KEY=
# Groq's catalogue moves; pin whichever model you actually tested against.
GROQ_MODEL=

# Sarvam Task Engine — multilingual NL -> task-graph planning.
SARVAM_API_KEY=

# Optional: Hugging Face token for downloading models by hand. No code in this repository reads it;
# the phone's model (Qwen2.5-1.5B-Instruct GGUF) is not gated.
HF_TOKEN=


# ---------------------------------------------------------------------- edge export
# The deployable artifact is always the local npz-int8 bundle: the only format the rover,
# fake rover and simulator run. SCANBORN_EXPORT adds one optional experiment beside it:
#
#   local    no experiment                                          (default)
#   ai-hub   compile and profile on Qualcomm AI Hub, remote         (needs AI_HUB_API_TOKEN,
#            plus qai_hub and torch: pip install -r requirements-npu.txt)
#   qairt    convert to a DLC with qairt-converter on this machine  (needs the Qualcomm AI
#            Runtime SDK on PATH, plus torch and onnx)
#
# An experiment's output is recorded in the /optimize response but is never deployable.
# Since 18 September 2026 AI_HUB_API_TOKEN alone does nothing: a setup that relied on the
# token to reach AI Hub must now also set SCANBORN_EXPORT=ai-hub. AI Hub compiles for
# Snapdragon devices in Qualcomm's cloud; there is no Exynos equivalent.
SCANBORN_EXPORT=local
# Get a token at https://app.aihub.qualcomm.com
AI_HUB_API_TOKEN=


# --------------------------------------------------------------------------- storage
# Where the orchestrator keeps its SQLite metadata store and its scan/mesh artifacts.
# Defaults shown; both are created on first use.
SCANBORN_DB=data/scanborn.db
SCANBORN_DATA=data


# ------------------------------------------------------------------------- dashboard
# Read by dashboard/vite.config.ts to proxy API calls to the orchestrator, so the
# browser talks to one origin and the orchestrator needs no CORS configuration.
ORCHESTRATOR_URL=http://localhost:8000
