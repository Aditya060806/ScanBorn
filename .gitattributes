# Line endings: let git normalise text and leave binaries alone.
* text=auto

# ── Source ────────────────────────────────────────────────────────────────────
*.py    text diff=python
*.kt    text
*.kts   text
*.java  text
*.c     text
*.h     text
*.cpp   text
*.js    text
*.jsx   text
*.ts    text
*.tsx   text
*.html  text diff=html
*.css   text
*.json  text
*.yaml  text
*.yml   text
*.toml  text
*.cfg   text
*.ini   text
*.md    text
*.rst   text
*.txt   text
*.gbnf  text
*.ino   text
*.gradle text
*.pro   text
*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# ── Binaries ──────────────────────────────────────────────────────────────────
# NOTE: no Git LFS here, deliberately.
#
# These patterns used to carry `filter=lfs`, which turned every committed image into a
# 131-byte pointer. That is the right trade for a repository full of multi-megabyte design
# assets and the wrong one here: the largest image in this project is under 1 MB, and the
# cost was that assets/logo.png and the two judging screenshots rendered as broken
# pointers on GitHub for anyone without the LFS objects.
#
# The one genuinely large file, MOBILE-APP's ~1 GB qwen.gguf, is handled by .gitignore and
# fetched separately per MOBILE-APP/setup_llama.ps1 — which is a better answer than LFS
# for a model weight that every contributor would otherwise pull on clone.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text
*.pdf   binary
*.onnx  binary
*.eot   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.gz    binary
*.tar.gz binary
*.rar   binary
*.7z    binary

# ── Merge-conflict debris ─────────────────────────────────────────────────────
*.orig       binary
*.BACKUP.*   binary
*.BASE.*     binary
*.LOCAL.*    binary
*.REMOTE.*   binary
*_BACKUP_*   binary
*_BASE_*     binary
*_LOCAL_*    binary
*_REMOTE_*   binary
